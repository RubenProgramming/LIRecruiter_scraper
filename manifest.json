{
  "manifest_version": 3,
  "name": "Recruiter Scraper",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "*://www.linkedin.com/*"
  ]
}
